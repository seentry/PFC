{% extends 'base.html.twig' %}

{% block title %}Trajes{% endblock %}

{% block body %}
    <h1>Trajes</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ traje.id }}</td>
            </tr>
            <tr>
                <th>Tipo</th>
                <td>{{ traje.tipo }}</td>
            </tr>
            <tr>
                <th>Talla</th>
                <td>{{ traje.talla }}</td>
            </tr>
            <tr>
                <th>Estado</th>
                <td>{{ traje.estado }}</td>
            </tr>
            <tr>
                <th>DuenoOriginal</th>
                <td>
                    {% if traje.duenoOriginal is not null and traje.duenoOriginal.id and traje.duenoOriginal.id > 0 %}
                        {{ traje.duenoOriginal.nombre }} {{ traje.duenoOriginal.apellidos }}
                    {% else %}
                        N/A
                    {% endif %}
                </td>

            </tr>
            <tr>
                <th>FechaIncorporacion</th>
                <td>{{ traje.fechaIncorporacion ? traje.fechaIncorporacion|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_trajes_index') }}">back to list</a>

    <a href="{{ path('app_trajes_edit', {'id': traje.id}) }}">edit</a>

    {{ include('trajes/_delete_form.html.twig') }}
{% endblock %}
