{% extends 'base.html.twig' %}

{% block title %}Trajes index{% endblock %}

{% block body %}
    <h1>Trajes index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Tipo</th>
                <th>Talla</th>
                <th>Estado</th>
                <th>DuenoOriginal</th>
                <th>FechaIncorporacion</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for traje in trajes %}
            <tr>
                <td>{{ traje.id }}</td>
                <td>{{ traje.tipo }}</td>
                <td>{{ traje.talla }}</td>
                <td>{{ traje.estado }}</td>
                <td>{{ traje.duenoOriginal }}</td>
                <td>{{ traje.fechaIncorporacion ? traje.fechaIncorporacion|date('Y-m-d') : '' }}</td>
                <td>
                    <a href="{{ path('app_trajes_show', {'id': traje.id}) }}">show</a>
                    <a href="{{ path('app_trajes_edit', {'id': traje.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_trajes_new') }}">Create new</a>
{% endblock %}
