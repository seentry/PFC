{% extends 'base.html.twig' %}

{% block title %}Padres{% endblock %}

{% block body %}
    <h1>Padres</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ padre.id }}</td>
            </tr>
            <tr>
                <th>Nombre</th>
                <td>{{ padre.nombre }}</td>
            </tr>
            <tr>
                <th>Apellidos</th>
                <td>{{ padre.apellidos }}</td>
            </tr>
            <tr>
                <th>AnoInscripcion</th>
                <td>{{ padre.anoInscripcion ? padre.anoInscripcion|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>EstadoPagos</th>
                <td>{{ padre.estadoPagos }}</td>
            </tr>
            <tr>
                <th>Credito</th>
                <td>{{ padre.credito }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_padres_index') }}">back to list</a>

    <a href="{{ path('app_padres_edit', {'id': padre.id}) }}">edit</a>

    {{ include('padres/_delete_form.html.twig') }}
{% endblock %}
