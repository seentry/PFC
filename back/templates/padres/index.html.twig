{% extends 'base.html.twig' %}

{% block title %}Padres index{% endblock %}

{% block body %}
    <h1>Padres index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Apellidos</th>
                <th>AnoInscripcion</th>
                <th>EstadoPagos</th>
                <th>Credito</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for padre in padres %}
            <tr>
                <td>{{ padre.id }}</td>
                <td>{{ padre.nombre }}</td>
                <td>{{ padre.apellidos }}</td>
                <td>{{ padre.anoInscripcion ? padre.anoInscripcion|date('Y-m-d') : '' }}</td>
                <td>{{ padre.estadoPagos }}</td>
                <td>{{ padre.credito }}</td>
                <td>
                    <a href="{{ path('app_padres_show', {'id': padre.id}) }}">show</a>
                    <a href="{{ path('app_padres_edit', {'id': padre.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_padres_new') }}">Create new</a>
{% endblock %}
